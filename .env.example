# Thoth Environment Configuration — example
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# NOTE: credentials previously committed in .env must be rotated.

# Brain Server
BRAIN_AUTH_TOKEN=
BRAIN_SERVER_URL=https://web-production-d7d37.up.railway.app

# Upload Configuration
UPLOAD_URL=
API_KEY=

# Flask Configuration
# Leave FLASK_SECRET_KEY empty to auto-generate a per-device secret.
FLASK_SECRET_KEY=
# Bind mode: loopback (default, safe) | lan (requires auth + THOTH_CORS_ORIGINS)
THOTH_BIND_MODE=loopback
FLASK_HOST=
FLASK_PORT=5000
FLASK_DEBUG=False
# Comma-separated CORS/WebSocket origin allowlist (loopback defaults if unset)
THOTH_CORS_ORIGINS=

# Data Collection
COLLECTION_RATE=1.0
DATA_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO

# Home Assistant MQTT Integration
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
