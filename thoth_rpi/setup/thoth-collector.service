[Unit]
Description=Thoth Continuous Minute Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=__PYTHON__ __COLLECTOR__
WorkingDirectory=__WORKDIR__
Environment=THOTH_ROOT=__THOTH_ROOT__
Environment=THOTH_CAPTURE_SCRIPT=__CAPTURE_SCRIPT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
