[Unit]
Description=Thoth Smart Home Sensor Platform
After=NetworkManager-wait-online.service network-online.target
Wants=NetworkManager-wait-online.service network-online.target

[Service]
Type=simple
User=pi
ExecStart=__PYTHON__ __APP__
WorkingDirectory=__WORKDIR__
Environment=THOTH_ROOT=__THOTH_ROOT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
Alias=thoth-web.service
